net: ethernet: mtk_eth_soc: fix NAPI enable order

Register the netdevs only after the dummy device and its NAPI contexts
exist, add mtk_napi_del() and use it on the probe error path and in
mtk_remove(), and free the dummy device when probe fails after it was
allocated.

2026-10-06 (6.18.55): the mtk_unreg_dev() hunk was dropped because stable
now skips unregistered netdevs itself (a `continue` before
unregister_netdev()), and the removed probe loop now reads
`goto err_unreg_netdev`, which 6.18.55 uses on register_netdev() failure.
The reordering, mtk_napi_del() and the dummy_dev cleanup are unchanged.

2026-10-24 (6.18.58): stable now does the reordering itself (dummy device
and its two NAPI contexts are allocated before the netdevs are registered,
and the probe error path deletes them and frees the dummy device). What is
left of this patch is the RSS-aware cleanup: mtk_napi_del() also drops the
rx_napi[1..3] contexts that 999-2711 adds, used on the probe error path
(where stable's netif_napi_del(&eth->rx_napi) no longer compiles once
rx_napi is an array) and in mtk_remove().

--- a/drivers/net/ethernet/mediatek/mtk_eth_soc.c
+++ b/drivers/net/ethernet/mediatek/mtk_eth_soc.c
@@ -5194,6 +5194,22 @@ static void mtk_pending_work(struct work
 	rtnl_unlock();
 }
 
+static void mtk_napi_del(struct mtk_eth *eth)
+{
+	int i;
+
+	if (!eth->dummy_dev)
+		return;
+
+	netif_napi_del(&eth->tx_napi);
+	netif_napi_del(&eth->rx_napi[0].napi);
+
+	if (MTK_HAS_CAPS(eth->soc->caps, MTK_RSS)) {
+		for (i = 1; i < MTK_RX_RSS_NUM; i++)
+			netif_napi_del(&eth->rx_napi[MTK_RSS_RING(i)].napi);
+	}
+}
+
 static int mtk_free_dev(struct mtk_eth *eth)
 {
 	int i;
@@ -6385,9 +6401,9 @@ err_deinit_ppe:
 	 */
 	cancel_work_sync(&eth->pending_work);
 	if (eth->dummy_dev) {
-		netif_napi_del(&eth->tx_napi);
-		netif_napi_del(&eth->rx_napi);
+		mtk_napi_del(eth);
 		free_netdev(eth->dummy_dev);
+		eth->dummy_dev = NULL;
 	}
 	mtk_ppe_deinit(eth);
 	mtk_mdio_cleanup(eth);
@@ -6421,13 +6437,7 @@ static void mtk_remove(struct platform_d
 	mtk_wed_exit();
 	mtk_hw_deinit(eth);
 
-	netif_napi_del(&eth->tx_napi);
-	netif_napi_del(&eth->rx_napi[0].napi);
-
-	if (MTK_HAS_CAPS(eth->soc->caps, MTK_RSS)) {
-		for (i = 1; i < MTK_RX_RSS_NUM; i++)
-			netif_napi_del(&eth->rx_napi[MTK_RSS_RING(i)].napi);
-	}
+	mtk_napi_del(eth);
 	mtk_cleanup(eth);
 	free_netdev(eth->dummy_dev);
 	mtk_mdio_cleanup(eth);
