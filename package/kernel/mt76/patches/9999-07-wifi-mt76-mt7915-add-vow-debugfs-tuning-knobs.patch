mt7915: add VoW/ATF developer tuning knobs on top of upstream ATF

Upstream openwrt/mt76 (>= 59676919) carries a native, minimal mt7915 VoW / HW
airtime-fairness implementation: a single on/off switch ("vow_atf" debugfs +
dev->vow_atf_en) with a hard-coded DRR quantum table and deficit bound.

This re-adds the finer-grained developer tuning knobs from MediaTek's original
VoW code (previously carried as the 2004-wed-HW-ATF patch, dropped because it
duplicated upstream's now-native implementation) as a self-contained debugfs
"vow" file that sits ON TOP of upstream's subsystem instead of replacing it:

  * ATF on/off stays single-sourced in upstream's "vow_atf" / dev->vow_atf_en.
  * New tunables: WATF enable + per-level quantum, per-station per-AC DRR
    quantum id, and the airtime deficit (max-wait) bound.
  * Read-back / dump helpers: show_vow_info, show_vow_sta_conf and a periodic
    per-station tx-airtime + PLE-queue dump (vow_show_en).

All added symbols are namespaced (mt7915_*vow_dbg*, MT7915_VOW_DBG_*,
dev->vow_dbg, msta->vow_dbg_quantum) so they never clash with upstream's VoW
API. The extended MCU requests reuse upstream's exact SET_DRR_CTRL /
SET_FEATURE_CTRL command layouts, differing only in the additional
runtime-configurable fields.

Only registered for chips that have HW ATF (!is_mt7915), matching the gate on
upstream's "vow_atf" file. This is a local, developer-only tuning surface with
no effect unless the debugfs knobs are written; drop it if MediaTek's richer
VoW support lands upstream.

--- a/mt7915/debugfs.c
+++ b/mt7915/debugfs.c
@@ -246,6 +246,292 @@ static int mt7915_vow_atf_get(void *data
 DEFINE_DEBUGFS_ATTRIBUTE(fops_vow_atf, mt7915_vow_atf_get, mt7915_vow_atf_set,
 			 "%lld\n");
 
+/* Developer VoW tuning knobs exposed via the debugfs "vow" file. These sit on
+ * top of upstream's native ATF: the ATF on/off switch stays in the separate
+ * "vow_atf" file (dev->vow_atf_en); this only adds the finer-grained runtime
+ * tuning (WATF, per-station DRR quantum, deficit bound) and read-back/dump
+ * helpers that upstream keeps hard-coded. Backed by mt7915_mcu_set_vow_dbg_*.
+ */
+static ssize_t mt7915_vow_dbg_read(struct file *file, char __user *user_buf,
+				   size_t count, loff_t *ppos)
+{
+	static const size_t bufsz = 1000;
+	char *buff;
+	int desc = 0;
+	ssize_t ret;
+
+	buff = kmalloc(bufsz, GFP_KERNEL);
+	if (!buff)
+		return -ENOMEM;
+
+	desc += scnprintf(buff + desc, bufsz - desc,
+		"===== VoW developer tuning knobs =====\n"
+		"(ATF on/off lives in the sibling 'vow_atf' file)\n"
+		"vow_watf_en=<0/1>\n"
+		"vow_watf_quantum=<level>-<quantum>          level 0..3, unit 256us\n"
+		"vow_sta_dwrr_quantum_id=<wcid>-<AC>-<Qid>   AC 0..3, Qid 0..3\n"
+		"vow_dwrr_max_wait_time=<time>               unit 256us\n"
+		"vow_show_en=<0/1>\n"
+		"vow_show_sta=<max wcid>\n"
+		"show_vow_info\n"
+		"show_vow_sta_conf=<wcid>  (0 = all)\n"
+		"e.g. echo show_vow_info > /sys/kernel/debug/ieee80211/phyX/mt76/vow\n");
+
+	ret = simple_read_from_buffer(user_buf, count, ppos, buff, desc);
+	kfree(buff);
+	return ret;
+}
+
+static int mt7915_set_vow_sta_dwrr_quantum_id(struct mt7915_dev *dev,
+					      u32 wcid_id, u32 ac, u32 qid)
+{
+	struct mt7915_sta *msta;
+	struct mt76_wcid *wcid;
+
+	wcid = rcu_dereference(dev->mt76.wcid[wcid_id]);
+	if (!wcid || !wcid->sta) {
+		dev_err(dev->mt76.dev, "%s: invalid station %u.\n",
+			__func__, wcid_id);
+		return -EINVAL;
+	}
+
+	msta = container_of(wcid, struct mt7915_sta, wcid);
+	msta->vow_dbg_quantum[ac] = qid;
+
+	return mt7915_mcu_set_vow_dbg_drr_ctrl(dev, msta,
+					       MT7915_VOW_DBG_STA_AC0_QUANTUM + ac);
+}
+
+static int mt7915_set_vow_dwrr_max_wait_time(struct mt7915_dev *dev, u32 val)
+{
+	dev->vow_dbg.max_wait_time = val;
+
+	return mt7915_mcu_set_vow_dbg_drr_ctrl(dev, NULL,
+					       MT7915_VOW_DBG_MAX_WAIT_TIME);
+}
+
+static int mt7915_set_vow_watf_en(struct mt7915_dev *dev, u32 val)
+{
+	dev->vow_dbg.watf_en = !!val;
+
+	return mt7915_mcu_set_vow_dbg_feature_ctrl(dev);
+}
+
+static int mt7915_set_vow_watf_quantum(struct mt7915_dev *dev, u32 id, u32 val)
+{
+	dev->vow_dbg.quantum[id] = val;
+
+	return mt7915_mcu_set_vow_dbg_drr_ctrl(dev, NULL,
+					       MT7915_VOW_DBG_QUANTUM_L0 + id);
+}
+
+static void mt7915_show_station_tx_airtime(struct work_struct *work)
+{
+	struct mt7915_dev *dev = container_of(work, struct mt7915_dev,
+					      vow_dbg.show_work.work);
+	static u32 vow_last_tx_time[MT7916_WTBL_SIZE];
+	struct ieee80211_sta *sta;
+	struct mt7915_sta *msta;
+	struct mt76_wcid *wcid;
+	u32 addr;
+	int idx, i, tx_airtime_sum, tx_add_airtime;
+
+	if (!dev->vow_dbg.show_en)
+		return;
+
+	rcu_read_lock();
+	for (idx = 1; idx < dev->vow_dbg.show_sta && idx < MT7915_WTBL_STA; idx++) {
+		if (idx >= ARRAY_SIZE(dev->mt76.wcid))
+			break;
+
+		wcid = rcu_dereference(dev->mt76.wcid[idx]);
+		if (!wcid || !wcid->sta)
+			continue;
+
+		msta = container_of(wcid, struct mt7915_sta, wcid);
+		addr = mt7915_mac_wtbl_lmac_addr(dev, idx, 20);
+		tx_airtime_sum = 0;
+
+		for (i = 0; i < IEEE80211_NUM_ACS; i++) {
+			tx_airtime_sum += mt76_rr(dev, addr);
+			addr += 8;
+		}
+		tx_add_airtime = tx_airtime_sum - vow_last_tx_time[idx];
+		vow_last_tx_time[idx] = tx_airtime_sum;
+
+		sta = container_of((void *)msta, struct ieee80211_sta, drv_priv);
+		dev_info(dev->mt76.dev, "sta%u: %pM tx -> %d\n",
+			 idx, sta->addr, tx_add_airtime);
+	}
+	mt7915_vow_pleinfo_read(dev);
+	ieee80211_queue_delayed_work(mt76_hw(dev), &dev->vow_dbg.show_work, HZ);
+	rcu_read_unlock();
+}
+
+static int mt7915_set_vow_show_en(struct mt7915_dev *dev, u32 val)
+{
+	if (!!dev->vow_dbg.show_en == !!val)
+		return 0;
+
+	dev->vow_dbg.show_en = val;
+	mt7915_mcu_set_vow_dbg_feature_ctrl(dev);
+
+	if (dev->vow_dbg.show_en) {
+		INIT_DELAYED_WORK(&dev->vow_dbg.show_work,
+				  mt7915_show_station_tx_airtime);
+		ieee80211_queue_delayed_work(mt76_hw(dev),
+					     &dev->vow_dbg.show_work, HZ);
+	} else {
+		cancel_delayed_work_sync(&dev->vow_dbg.show_work);
+	}
+
+	return 0;
+}
+
+static int mt7915_set_vow_show_sta(struct mt7915_dev *dev, u32 val)
+{
+	dev->vow_dbg.show_sta = val;
+
+	return 0;
+}
+
+static int mt7915_show_vow_info(struct mt7915_dev *dev)
+{
+	int i;
+
+	dev_info(dev->mt76.dev, "====== VoW control information ======\n");
+	dev_info(dev->mt76.dev, "ATF enable:  %d (via 'vow_atf')\n",
+		 dev->vow_atf_en);
+	dev_info(dev->mt76.dev, "WATF enable: %d\n", dev->vow_dbg.watf_en);
+	dev_info(dev->mt76.dev, "Max deficit (unit 256us): %d\n",
+		 dev->vow_dbg.max_wait_time);
+	for (i = 0; i < VOW_DRR_QUANTUM_NUM; i++)
+		dev_info(dev->mt76.dev, "Quantum level %d (unit 256us): %d\n",
+			 i, dev->vow_dbg.quantum[i]);
+
+	return 0;
+}
+
+static void mt7915_show_vow_one_sta(struct mt7915_dev *dev, u32 idx)
+{
+	struct ieee80211_sta *sta;
+	struct mt7915_sta *msta;
+	struct mt76_wcid *wcid;
+	static const char * const ac_name[IEEE80211_NUM_ACS] = {
+		"AC0", "AC1", "AC2", "AC3"
+	};
+	int ac;
+
+	wcid = rcu_dereference(dev->mt76.wcid[idx]);
+	if (!wcid || !wcid->sta)
+		return;
+
+	msta = container_of(wcid, struct mt7915_sta, wcid);
+	sta = container_of((void *)msta, struct ieee80211_sta, drv_priv);
+	dev_info(dev->mt76.dev, "****** sta%u: %pM ******\n", idx, sta->addr);
+
+	for (ac = 0; ac < IEEE80211_NUM_ACS; ac++) {
+		u8 q = msta->vow_dbg_quantum[ac];
+
+		dev_info(dev->mt76.dev, "%s --> %uus (Qid %u)\n",
+			 ac_name[ac], dev->vow_dbg.quantum[q] << 8, q);
+	}
+}
+
+static int mt7915_show_vow_sta_conf(struct mt7915_dev *dev, u32 val)
+{
+	u32 i;
+
+	rcu_read_lock();
+	if (val > 0 && val < MT7915_WTBL_STA) {
+		mt7915_show_vow_one_sta(dev, val);
+	} else {
+		for (i = 1; i < MT7915_WTBL_STA; i++)
+			mt7915_show_vow_one_sta(dev, i);
+	}
+	rcu_read_unlock();
+
+	return 0;
+}
+
+static ssize_t mt7915_vow_dbg_write(struct file *file, const char __user *user_buf,
+				    size_t count, loff_t *ppos)
+{
+	struct mt7915_phy *phy = file->private_data;
+	struct mt7915_dev *dev = phy->dev;
+	u32 param1, param2, param3;
+	char buf[64];
+	int ret;
+
+	if (count >= sizeof(buf))
+		return -EINVAL;
+
+	if (copy_from_user(buf, user_buf, count))
+		return -EFAULT;
+
+	if (count && buf[count - 1] == '\n')
+		buf[count - 1] = '\0';
+	else
+		buf[count] = '\0';
+
+	if (!strncmp(buf, "vow_sta_dwrr_quantum_id", strlen("vow_sta_dwrr_quantum_id"))) {
+		ret = sscanf(buf, "vow_sta_dwrr_quantum_id=%u-%u-%u",
+			     &param1, &param2, &param3);
+		if (ret != 3 || param2 >= IEEE80211_NUM_ACS ||
+		    param3 >= VOW_DRR_QUANTUM_NUM)
+			return -EINVAL;
+
+		ret = mt7915_set_vow_sta_dwrr_quantum_id(dev, param1, param2, param3);
+	} else if (!strncmp(buf, "vow_dwrr_max_wait_time", strlen("vow_dwrr_max_wait_time"))) {
+		if (sscanf(buf, "vow_dwrr_max_wait_time=%u", &param1) != 1)
+			return -EINVAL;
+
+		ret = mt7915_set_vow_dwrr_max_wait_time(dev, param1);
+	} else if (!strncmp(buf, "vow_watf_en", strlen("vow_watf_en"))) {
+		if (sscanf(buf, "vow_watf_en=%u", &param1) != 1)
+			return -EINVAL;
+
+		ret = mt7915_set_vow_watf_en(dev, param1);
+	} else if (!strncmp(buf, "vow_watf_quantum", strlen("vow_watf_quantum"))) {
+		ret = sscanf(buf, "vow_watf_quantum=%u-%u", &param1, &param2);
+		if (!dev->vow_dbg.watf_en || ret != 2 ||
+		    param1 >= MT7915_VOW_DBG_WATF_LEVEL_NUM)
+			return -EINVAL;
+
+		ret = mt7915_set_vow_watf_quantum(dev, param1, param2);
+	} else if (!strncmp(buf, "vow_show_en", strlen("vow_show_en"))) {
+		if (sscanf(buf, "vow_show_en=%u", &param1) != 1)
+			return -EINVAL;
+
+		ret = mt7915_set_vow_show_en(dev, param1);
+	} else if (!strncmp(buf, "vow_show_sta", strlen("vow_show_sta"))) {
+		if (sscanf(buf, "vow_show_sta=%u", &param1) != 1 ||
+		    param1 >= MT7915_WTBL_STA)
+			return -EINVAL;
+
+		ret = mt7915_set_vow_show_sta(dev, param1);
+	} else if (!strncmp(buf, "show_vow_info", strlen("show_vow_info"))) {
+		ret = mt7915_show_vow_info(dev);
+	} else if (!strncmp(buf, "show_vow_sta_conf", strlen("show_vow_sta_conf"))) {
+		if (sscanf(buf, "show_vow_sta_conf=%u", &param1) != 1 ||
+		    param1 >= MT7915_WTBL_STA)
+			return -EINVAL;
+
+		ret = mt7915_show_vow_sta_conf(dev, param1);
+	} else {
+		return -EINVAL;
+	}
+
+	return ret ? ret : count;
+}
+
+static const struct file_operations mt7915_vow_dbg_ops = {
+	.write = mt7915_vow_dbg_write,
+	.read = mt7915_vow_dbg_read,
+	.open = simple_open,
+	.llseek = default_llseek,
+};
