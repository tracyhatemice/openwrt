+/* Extended DRR control used only by the debugfs "vow" tuning knobs. It reaches
+ * the same firmware command (SET_DRR_CTRL) as upstream's
+ * mt7915_mcu_set_vow_drr_ctrl(), but exposes the per-station / per-level
+ * sub-commands that upstream keeps hard-coded, sourcing the values from the
+ * runtime debug state (dev->vow_dbg, msta->vow_dbg_quantum).
+ */
+int mt7915_mcu_set_vow_dbg_drr_ctrl(struct mt7915_dev *dev,
+				    struct mt7915_sta *msta, u32 subcmd)
+{
+	struct {
+		__le32 action;
+		u8 wlan_idx_lo;
+		u8 status;
+		u8 wlan_idx_hi;
+		u8 rsv0[5];
+		union {
+			__le32 com_value;
+			struct {
+				u8 air_time_quantum[VOW_DRR_QUANTUM_NUM];
+			} air_time_quantum_all;
+		} air_time_ctrl;
+	} __packed req = {
+		.action = cpu_to_le32(subcmd),
+		.wlan_idx_lo = msta ? to_wcid_lo(msta->wcid.idx) : 0,
+		.wlan_idx_hi = msta ? to_wcid_hi(msta->wcid.idx) : 0,
+	};
+
+	switch (subcmd) {
+	case MT7915_VOW_DBG_STA_AC0_QUANTUM:
+		req.air_time_ctrl.com_value =
+			cpu_to_le32(msta->vow_dbg_quantum[IEEE80211_AC_VO]);
+		break;
+	case MT7915_VOW_DBG_STA_AC1_QUANTUM:
+		req.air_time_ctrl.com_value =
+			cpu_to_le32(msta->vow_dbg_quantum[IEEE80211_AC_VI]);
+		break;
+	case MT7915_VOW_DBG_STA_AC2_QUANTUM:
+		req.air_time_ctrl.com_value =
+			cpu_to_le32(msta->vow_dbg_quantum[IEEE80211_AC_BE]);
+		break;
+	case MT7915_VOW_DBG_STA_AC3_QUANTUM:
+		req.air_time_ctrl.com_value =
+			cpu_to_le32(msta->vow_dbg_quantum[IEEE80211_AC_BK]);
+		break;
+	case MT7915_VOW_DBG_MAX_WAIT_TIME:
+		req.air_time_ctrl.com_value =
+			cpu_to_le32(dev->vow_dbg.max_wait_time);
+		break;
+	case MT7915_VOW_DBG_QUANTUM_L0 ... MT7915_VOW_DBG_QUANTUM_L7:
+		req.air_time_ctrl.com_value =
+			cpu_to_le32(dev->vow_dbg.quantum[subcmd -
+						MT7915_VOW_DBG_QUANTUM_L0]);
+		break;
+	default:
+		break;
+	}
+
+	return mt76_mcu_send_msg(&dev->mt76, MCU_EXT_CMD(SET_DRR_CTRL),
+				 &req, sizeof(req), false);
+}
+
+/* Feature control for the debug knobs: identical firmware request to upstream's
+ * mt7915_mcu_set_vow_feature_ctrl(), but additionally honours the WATF-enable
+ * and show-engine debug bits. The ATF-enable bit still tracks upstream's
+ * dev->vow_atf_en so the on/off switch stays single-sourced.
+ */
+int mt7915_mcu_set_vow_dbg_feature_ctrl(struct mt7915_dev *dev)
+{
+	u16 value = 0;
+	u32 sch_value = 0;
+	struct vow_feature_ctrl {
+		__le16 bss_flag;
+		__le16 vow_ctrl_flag;
+		__le16 bss_value[9];
+		__le16 vow_ctrl_val;
+		__le16 time_token_value[2];
+		__le16 length_token_value[2];
+		__le32 tx_ctrl;
+		__le32 sch_ctrl;
+	} __packed req = {
+		.bss_flag = cpu_to_le16(0xffff),
+		.vow_ctrl_flag = cpu_to_le16(0xf231),
+		.bss_value[0] = cpu_to_le16(0xffff),
+		.bss_value[2] = cpu_to_le16(0xffff),
+		.bss_value[8] = cpu_to_le16(0xffff),
+		.time_token_value[0] = cpu_to_le16(0xffff),
+	};
+
+	value |= VOW_REFILL_PERIOD_32US;
+	value |= 1 << 4;
+	value |= 1 << 5;
+	value |= dev->vow_dbg.watf_en << 9;	/* WATF enable */
+	value |= 1 << 12;
+	value |= dev->vow_atf_en << 13;		/* ATF enable (upstream state) */
+	value |= 1 << 14;
+	req.vow_ctrl_val = cpu_to_le16(value);
+
+	if (dev->vow_atf_en)
+		req.tx_ctrl = cpu_to_le32(0x6bf69e1f);
+
+	sch_value |= 1 << 6;
+	sch_value |= (dev->vow_dbg.show_en ? dev->vow_dbg.show_en - 1 : 0) << 4;
+	req.sch_ctrl = cpu_to_le32(sch_value);
+
+	return mt76_mcu_send_msg(&dev->mt76, MCU_EXT_CMD(SET_FEATURE_CTRL),
+				 &req, sizeof(req), false);
+}
