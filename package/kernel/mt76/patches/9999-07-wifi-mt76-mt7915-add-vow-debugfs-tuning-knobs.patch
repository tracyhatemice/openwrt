+/* Optional developer VoW tuning knobs, exposed via the debugfs "vow" file.
+ * These sit ON TOP of upstream's native ATF (which owns the on/off switch via
+ * the "vow_atf" file and dev->vow_atf_en); this only adds finer-grained,
+ * runtime-only tuning that upstream keeps hard-coded. Symbols are namespaced
+ * with a _dbg / MT7915_VOW_DBG_ prefix so they never clash with upstream.
+ */
+#define MT7915_VOW_DBG_WATF_LEVEL_NUM	4
+
+/* Sub-commands for the extended MCU_EXT_CMD(SET_DRR_CTRL) request; the values
+ * are firmware ABI and match the hardware's DRR control indices.
+ */
+enum mt7915_vow_dbg_drr_ctrl {
+	MT7915_VOW_DBG_STA_AC0_QUANTUM	= 0x03,
+	MT7915_VOW_DBG_STA_AC1_QUANTUM	= 0x04,
+	MT7915_VOW_DBG_STA_AC2_QUANTUM	= 0x05,
+	MT7915_VOW_DBG_STA_AC3_QUANTUM	= 0x06,
+	MT7915_VOW_DBG_MAX_WAIT_TIME	= 0x10,
+	MT7915_VOW_DBG_QUANTUM_L0	= 0x20,
+	MT7915_VOW_DBG_QUANTUM_L7	= 0x27,
+};
+
+struct mt7915_vow_dbg_cfg {
+	bool	watf_en;
+	u8	max_wait_time;			/* airtime deficit bound, unit 256us */
+	u8	quantum[VOW_DRR_QUANTUM_NUM];	/* per-level WATF quantum */
+	u8	show_en;
+	u32	show_sta;
+	struct delayed_work show_work;
+};
 
